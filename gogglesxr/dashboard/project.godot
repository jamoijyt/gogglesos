; GogglesXR dashboard (Godot 4.4+). Open this folder in Godot, or run:  godot --path gogglesxr/dashboard
config_version=5

[application]

config/name="GogglesXR Dashboard"
config/description="The five-panel dashboard for GogglesXR"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.4", "Forward Plus")

[display]

window/size/viewport_width=1280
window/size/viewport_height=800

[rendering]

renderer/rendering_method="mobile"
environment/defaults/default_clear_color=Color(0.012, 0.043, 0.039, 1)

[xr]

openxr/enabled=true
openxr/startup_alert=false
shaders/enabled=true
