#!/usr/bin/python3
"""Goggles Update: bring an installed Goggles OS up to date with the GitHub repository,
without a new ISO.

It downloads the Goggles OS source for the chosen version, then runs the same system
configuration step the ISO build uses (chroot/apply-system.sh): overlay files, branding,
themes, start menu, login and boot splash, plus any apps newly added to config.sh.
Ubuntu packages and drivers keep updating through Discover / apt as usual.

  goggles-update                 check; in a terminal it prints, from the menu it shows dialogs
  goggles-update --check         print whether an update is available (exit 10 if so)
  goggles-update --status        show the installed version and settings
  sudo goggles-update --apply    install the latest update
  sudo goggles-update --channel main|stable
                                 main = every change on GitHub (testing), stable = releases only
  sudo goggles-update --rollback undo the last update's file changes
"""
import argparse
import datetime
import fcntl
import json
import os
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
import urllib.error
import urllib.parse
import urllib.request

STATE = "/var/lib/gogglesos"
DEFAULTS_FILE = "/usr/share/gogglesos/update-defaults.conf"
CONF_FILE = "/etc/gogglesos/update.conf"
LOG_FILE = "/var/log/gogglesos-update.log"
LOCK_FILE = "/run/goggles-update.lock"
ROLLBACK_DIR = STATE + "/rollback"
SELF = "/usr/bin/goggles-update"
CHANNELS = ("stable", "main")
SHA_RE = re.compile(r"^[0-9a-f]{40}$")
REPO_RE = re.compile(r"^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$")
BRANCH_RE = re.compile(r"^[A-Za-z0-9_./-]+$")
TITLE = "Goggles Update"
# Tools branding/make-assets.sh needs to draw the logos, icons and wallpaper
ASSET_PACKAGES = ["imagemagick", "webp", "fonts-dejavu-core"]


class UpdateError(Exception):
    pass


# ------------------------------------------------------------------ settings
def read_kv(path):
    out = {}
    try:
        with open(path, encoding="utf-8") as f:
            for line in f:
                line = line.split("#", 1)[0].strip()
                if "=" in line:
                    k, v = line.split("=", 1)
                    out[k.strip()] = v.strip().strip('"').strip("'")
    except OSError:
        pass
    return out


def settings():
    cfg = {"REPO": "jamoijyt/gogglesos", "CHANNEL": "stable", "BRANCH": "main", "DISTRO_ID": "gogglesos"}
    cfg.update(read_kv(DEFAULTS_FILE))
    cfg.update(read_kv(CONF_FILE))
    if not REPO_RE.match(cfg["REPO"]):
        raise UpdateError(f"invalid REPO in settings: {cfg['REPO']!r}")
    if cfg["CHANNEL"] not in CHANNELS:
        cfg["CHANNEL"] = "stable"
    if not BRANCH_RE.match(cfg["BRANCH"]) or ".." in cfg["BRANCH"]:
        raise UpdateError(f"invalid BRANCH in settings: {cfg['BRANCH']!r}")
    return cfg


def installed():
    v = read_kv(STATE + "/version")
    v.setdefault("COMMIT", "unknown")
    return v


def set_channel(channel):
    need_root()
    os.makedirs(os.path.dirname(CONF_FILE), exist_ok=True)
    conf = read_kv(CONF_FILE)
    conf["CHANNEL"] = channel
    with open(CONF_FILE, "w", encoding="utf-8") as f:
        f.write("# Goggles Update settings (defaults: %s)\n" % DEFAULTS_FILE)
        for k, v in conf.items():
            f.write(f"{k}={v}\n")
    os.chmod(CONF_FILE, 0o644)
    print(f"Update channel: {channel}" + (" (every change on GitHub)" if channel == "main" else " (releases only)"))


# ------------------------------------------------------------------ GitHub
def http(url, accept="application/vnd.github+json"):
    req = urllib.request.Request(url, headers={"User-Agent": "goggles-update", "Accept": accept})
    try:
        return urllib.request.urlopen(req, timeout=60)
    except urllib.error.HTTPError as e:
        if e.code == 403 and e.headers.get("X-RateLimit-Remaining") == "0":
            raise UpdateError("GitHub's limit for update checks was reached. Try again in an hour.") from e
        raise
    except urllib.error.URLError as e:
        raise UpdateError(f"Couldn't reach GitHub ({e.reason}). Check your internet connection.") from e


def gh(cfg, path):
    with http(f"https://api.github.com/repos/{cfg['REPO']}{path}") as r:
        return json.load(r)


def latest(cfg):
    """The newest version on the configured channel, or None if there's no release yet."""
    if cfg["CHANNEL"] == "main":
        c = gh(cfg, "/commits/" + urllib.parse.quote(cfg["BRANCH"], safe=""))
        return {"sha": c["sha"], "label": f"{cfg['BRANCH']} @ {c['sha'][:7]}",
                "date": c["commit"]["committer"]["date"], "title": c["commit"]["message"].splitlines()[0]}
    try:
        rel = gh(cfg, "/releases/latest")
    except urllib.error.HTTPError as e:
        if e.code == 404:
            return None
        raise UpdateError(f"GitHub returned an error ({e.code}).") from e
    c = gh(cfg, "/commits/" + urllib.parse.quote(rel["tag_name"], safe=""))
    return {"sha": c["sha"], "label": rel["tag_name"], "date": rel.get("published_at") or "",
            "title": rel.get("name") or rel["tag_name"]}


def status(cfg):
    inst = installed()
    cur = inst["COMMIT"]
    base = cur[:-6] if cur.endswith("-dirty") else cur
    try:
        target = latest(cfg)
    except urllib.error.HTTPError as e:
        raise UpdateError(f"GitHub returned an error ({e.code}).") from e
    st = {"installed": cur, "target": target, "changes": [], "channel": cfg["CHANNEL"]}
    if target is None:
        st["state"] = "no-release"
    elif cur == target["sha"]:
        st["state"] = "up-to-date"
    else:
        st["state"] = "available"
        if SHA_RE.match(base):
            try:
                cmp = gh(cfg, f"/compare/{base}...{target['sha']}")
                if cmp.get("status") == "behind":
                    st["state"] = "newer"      # installed version is ahead of this channel
                st["changes"] = [c["commit"]["message"].splitlines()[0] for c in cmp.get("commits", [])]
            except (urllib.error.HTTPError, UpdateError):
                pass                           # e.g. a commit GitHub no longer has: just offer the update
        if not st["changes"]:
            # Installed version unknown: show the most recent changes instead
            try:
                recent = gh(cfg, f"/commits?sha={target['sha']}&per_page=15")
                st["recent"] = [c["commit"]["message"].splitlines()[0] for c in reversed(recent)]
            except (urllib.error.HTTPError, UpdateError):
                pass
    return st


def describe(st):
    t = st["target"]
    if st["state"] == "no-release":
        return ("There's no Goggles OS release yet.\n\n"
                "To follow every change on GitHub (testing), run:\n  sudo goggles-update --channel main")
    if st["state"] == "up-to-date":
        return f"Goggles OS is up to date ({t['label']})."
    if st["state"] == "newer":
        return (f"The installed version is newer than the latest on the {st['channel']} channel "
                f"({t['label']}). Nothing to update.")
    lines = [f"An update is available: {t['label']}"]
    changes = [c for c in reversed(st["changes"] or st.get("recent", [])) if not c.startswith("Merge ")]
    if changes:
        lines.append("\nWhat's new:" if st["changes"] else "\nRecent changes:")
        lines += ["  • " + c for c in changes[:12]]
        if len(changes) > 12:
            lines.append(f"  … and {len(changes) - 12} more")
    elif t.get("title"):
        lines.append(f"\nLatest change: {t['title']}")
    if st["installed"] == "unknown":
        lines.append("\n(The installed version isn't recorded yet, so everything will be re-applied.)")
    return "\n".join(lines)


# ------------------------------------------------------------------ applying
def need_root():
    if os.geteuid() != 0:
        raise UpdateError("This needs administrator rights: run it with sudo.")


class Log:
    """Print to the terminal and append to the update log."""
    def __init__(self):
        os.makedirs(os.path.dirname(LOG_FILE), exist_ok=True)
        self.f = open(LOG_FILE, "a", encoding="utf-8")
        os.chmod(LOG_FILE, 0o644)

    def __call__(self, msg=""):
        print(msg, flush=True)
        self.f.write(msg + "\n")
        self.f.flush()

    def run(self, cmd, env=None, cwd=None):
        self(f"$ {' '.join(cmd)}")
        p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, env=env, cwd=cwd,
                             text=True, errors="replace")
        for line in p.stdout:
            sys.stdout.write(line)
            sys.stdout.flush()
            self.f.write(line)
        self.f.flush()
        if p.wait() != 0:
            raise UpdateError(f"step failed: {' '.join(cmd)} (exit {p.returncode}). Details: {LOG_FILE}")


def lock():
    f = open(LOCK_FILE, "w")
    try:
        fcntl.flock(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        raise UpdateError("Another update is already running.")
    return f


def download(cfg, sha, work, log):
    url = f"https://codeload.github.com/{cfg['REPO']}/tar.gz/{sha}"
    log(f"Downloading {cfg['REPO']} {sha[:12]}")
    path = os.path.join(work, "source.tar.gz")
    with http(url, accept="application/octet-stream") as r, open(path, "wb") as f:
        shutil.copyfileobj(r, f)
    with tarfile.open(path) as tf:
        # GitHub stamps the archive with the commit it was made from
        if tf.pax_headers.get("comment") != sha:
            raise UpdateError("The download doesn't match the requested version; not installing it.")
        tops = {m.name.split("/", 1)[0] for m in tf.getmembers()}
        if len(tops) != 1:
            raise UpdateError("Unexpected archive layout; not installing it.")
        if hasattr(tarfile, "data_filter"):
            tf.extractall(work, filter="data")
        else:  # very old Python: refuse anything that could escape the folder
            for m in tf.getmembers():
                if m.name.startswith("/") or ".." in m.name.split("/") or m.issym() or m.islnk() or m.isdev():
                    raise UpdateError(f"Unsafe path in archive: {m.name}")
            tf.extractall(work)
    src = os.path.join(work, tops.pop())
    for need in ("config.sh", "chroot/apply-system.sh", "overlay", "third_party", "branding/make-assets.sh"):
        if not os.path.exists(os.path.join(src, need)):
            raise UpdateError(f"This version can't be installed as an update (it has no {need}).")
    return src


def ensure_asset_tools(log):
    missing = [p for p in ASSET_PACKAGES if subprocess.run(
        ["dpkg-query", "-W", "-f=${Status}", p], capture_output=True, text=True).stdout.find("ok installed") < 0]
    if not missing:
        return
    log(f"Installing tools for the branding images: {' '.join(missing)}")
    apt = ["apt-get", "-y", "-o", "DPkg::Lock::Timeout=300", "install", *missing]
    env = dict(os.environ, DEBIAN_FRONTEND="noninteractive")
    try:
        log.run(apt, env=env)
    except UpdateError:
        log.run(["apt-get", "update"], env=env)
        log.run(apt, env=env)


def snapshot_paths(src, distro_id):
    """Everything apply-system.sh rewrites (except package installs), for --rollback."""
    paths = [
        "/etc/xdg", "/etc/skel", "/usr/lib/os-release", "/etc/lsb-release", "/etc/issue", "/etc/issue.net",
        f"/usr/share/plasma/look-and-feel/org.{distro_id}.desktop",
        f"/usr/share/plasma/layout-templates/org.{distro_id}.desktop.defaultPanel",
        f"/usr/share/plasma/desktoptheme/{distro_id}", "/usr/share/Kvantum/GogglesGlass",
        "/usr/share/color-schemes/GogglesDark.colors", "/usr/share/plasma/plasmoids/com.github.zren.tiledmenu",
        f"/usr/share/plasma/plasmoids/org.{distro_id}.hud", f"/usr/share/sddm/themes/{distro_id}", "/etc/sddm.conf.d",
        "/usr/share/wallpapers/GogglesOS", f"/usr/share/{distro_id}", f"/usr/share/plymouth/themes/{distro_id}",
        "/usr/local/share/applications", "/usr/bin/papirus-folders", f"/usr/share/pixmaps/{distro_id}.png",
        f"/usr/share/pixmaps/{distro_id}-logo.png", "/etc/systemd/user/timers.target.wants/goggles-update-check.timer",
        STATE + "/version", STATE + "/apt-packages", STATE + "/flatpaks", STATE + "/overlay-files",
    ]
    for d in os.listdir("/usr/share/icons/hicolor") if os.path.isdir("/usr/share/icons/hicolor") else []:
        paths.append(f"/usr/share/icons/hicolor/{d}/apps/{distro_id}.png")
    if os.path.isdir("/usr/share/sddm/themes"):
        paths += [f"/usr/share/sddm/themes/{t}/theme.conf.user" for t in os.listdir("/usr/share/sddm/themes")]
    try:
        with open(STATE + "/overlay-files", encoding="utf-8") as f:
            paths += [l.strip() for l in f if l.strip()]
    except OSError:
        pass
    for root, _, files in os.walk(os.path.join(src, "overlay")):
        for name in files:
            paths.append("/" + os.path.relpath(os.path.join(root, name), os.path.join(src, "overlay")))
    seen, out = set(), []
    for p in paths:
        if p not in seen and (p.startswith("/etc/") or p.startswith("/usr/") or p.startswith(STATE)):
            seen.add(p)
            out.append(p)
    return out


def snapshot(src, distro_id, log):
    paths = snapshot_paths(src, distro_id)
    existing = [p for p in paths if os.path.lexists(p)]
    os.makedirs(ROLLBACK_DIR, mode=0o700, exist_ok=True)
    tmp = ROLLBACK_DIR + "/files.tar.gz.new"
    log("Saving the current files so this update can be undone (goggles-update --rollback)")
    # tar exits 1 for "file changed as we read it", which is fine here
    rc = subprocess.run(["tar", "-C", "/", "--ignore-failed-read", "-cpzf", tmp,
                         *[p.lstrip("/") for p in existing]], stdout=subprocess.DEVNULL).returncode
    if rc not in (0, 1):
        raise UpdateError(f"Couldn't save the current files (tar exit {rc}); not updating.")
    os.replace(tmp, ROLLBACK_DIR + "/files.tar.gz")
    with open(ROLLBACK_DIR + "/manifest.json", "w", encoding="utf-8") as f:
        json.dump({"paths": paths, "existing": existing, "commit": installed()["COMMIT"],
                   "date": datetime.datetime.now(datetime.timezone.utc).isoformat()}, f, indent=1)


def apply(cfg, ref=None, assume_yes=False):
    need_root()
    held = lock()
    log = Log()
    log(f"\n=== Goggles Update {datetime.datetime.now().isoformat(timespec='seconds')} ===")
    if ref:
        if not SHA_RE.match(ref):
            raise UpdateError("--ref must be a full 40-character commit ID")
        target = ref
    else:
        st = status(cfg)
        log(describe(st))
        if st["state"] != "available":
            return 0
        if not assume_yes and sys.stdin.isatty():
            if input("\nInstall it now? [y/N] ").strip().lower() not in ("y", "yes"):
                return 0
        target = st["target"]["sha"]

    os.makedirs(STATE + "/work", mode=0o700, exist_ok=True)
    work = tempfile.mkdtemp(prefix="update-", dir=STATE + "/work")
    try:
        src = download(cfg, target, work, log)
        ensure_asset_tools(log)
        log("Drawing branding images")
        log.run(["bash", os.path.join(src, "branding/make-assets.sh"), os.path.join(work, "assets")])
        snapshot(src, cfg["DISTRO_ID"], log)
        env = {
            "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
            "HOME": "/root", "LANG": "C.UTF-8", "TERM": os.environ.get("TERM", "dumb"),
            "G": src, "A": os.path.join(work, "assets"), "APPLY_MODE": "update", "SOURCE_COMMIT": target,
        }
        log.run(["bash", os.path.join(src, "chroot/apply-system.sh")], env=env, cwd=work)
    finally:
        shutil.rmtree(work, ignore_errors=True)
        held.close()
    log(f"\nGoggles OS updated to {target[:12]}.")
    log("Log out and back in to see desktop changes. Undo with: sudo goggles-update --rollback")
    return 0


def rollback():
    need_root()
    held = lock()
    log = Log()
    manifest = ROLLBACK_DIR + "/manifest.json"
    if not os.path.exists(manifest):
        raise UpdateError("There's no update to undo.")
    with open(manifest, encoding="utf-8") as f:
        m = json.load(f)
    log(f"\n=== Goggles Update rollback to {m['commit']} (saved {m['date']}) ===")
    # Remove what the update added; everything that existed before is restored from the saved copy
    existed = set(m["existing"])
    for p in m["paths"]:
        if p in existed or not (p.startswith("/etc/") or p.startswith("/usr/") or p.startswith(STATE)):
            continue
        if os.path.isdir(p) and not os.path.islink(p):
            shutil.rmtree(p)
        elif os.path.lexists(p):
            os.unlink(p)
    log.run(["tar", "-C", "/", "-xpzf", ROLLBACK_DIR + "/files.tar.gz"])
    for cmd in (["update-grub"], ["update-initramfs", "-u"], ["sysctl", "-q", "--system"]):
        try:
            log.run(cmd)
        except (UpdateError, OSError) as e:
            log(f"warning: {e}")
    os.remove(manifest)
    held.close()
    log("Rolled back. Log out and back in. (Apps installed by the update are kept.)")
    return 0


# ------------------------------------------------------------------ desktop
def have_display():
    return bool(os.environ.get("WAYLAND_DISPLAY") or os.environ.get("DISPLAY")) and shutil.which("kdialog")


def kdialog(*args):
    return subprocess.run(["kdialog", "--title", TITLE, *args]).returncode


def run_as_admin(args):
    """Run goggles-update as root in a terminal window so progress and errors are visible."""
    cmd = ["pkexec", SELF, *args]
    if shutil.which("konsole"):
        subprocess.run(["konsole", "--hold", "-e", *cmd])
        return None
    return subprocess.run(cmd).returncode


def gui(cfg):
    try:
        st = status(cfg)
    except UpdateError as e:
        kdialog("--sorry", str(e))
        return 1
    if st["state"] == "no-release":
        if kdialog("--yes-label", "Follow main", "--no-label", "Close", "--yesno",
                   "There's no Goggles OS release yet.\n\nFollow every change on GitHub instead? "
                   "Use this for testing: changes arrive as soon as they're merged.") != 0:
            return 0
        if subprocess.run(["pkexec", SELF, "--channel", "main"]).returncode != 0:
            return 1
        return gui(settings())
    if st["state"] != "available":
        kdialog("--msgbox", describe(st))
        return 0
    if kdialog("--yes-label", "Update now", "--no-label", "Later", "--yesno", describe(st)) == 0:
        rc = run_as_admin(["--apply", "--yes", "--ref", st["target"]["sha"]])
        if rc is not None:
            kdialog("--msgbox" if rc == 0 else "--error",
                    "Goggles OS is updated. Log out and back in to see desktop changes." if rc == 0
                    else f"The update didn't finish. Details: {LOG_FILE}")
    return 0


def notify(cfg):
    """Run daily by the goggles-update-check user timer: a quiet popup when there's something new."""
    try:
        st = status(cfg)
    except UpdateError:
        return 0
    if st["state"] != "available" or not have_display():
        return 0
    seen_file = os.path.join(os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")), "goggles-update-seen")
    try:
        with open(seen_file, encoding="utf-8") as f:
            if f.read().strip() == st["target"]["sha"]:
                return 0
    except OSError:
        pass
    kdialog("--passivepopup", f"A Goggles OS update is available ({st['target']['label']}).\n"
            "Open Goggles Update from the app menu to install it.", "20")
    os.makedirs(os.path.dirname(seen_file), exist_ok=True)
    with open(seen_file, "w", encoding="utf-8") as f:
        f.write(st["target"]["sha"])
    return 0


# ------------------------------------------------------------------ main
def main():
    ap = argparse.ArgumentParser(description="Get the latest Goggles OS changes without a new ISO.")
    ap.add_argument("--check", action="store_true", help="print whether an update is available (exit 10 if so)")
    ap.add_argument("--status", action="store_true", help="show the installed version and settings")
    ap.add_argument("--apply", action="store_true", help="install the latest update (root)")
    ap.add_argument("--ref", help="install this exact commit (40-character ID) instead of the latest")
    ap.add_argument("--yes", action="store_true", help="don't ask before installing")
    ap.add_argument("--channel", choices=CHANNELS, help="stable = releases, main = every change (root)")
    ap.add_argument("--rollback", action="store_true", help="undo the last update's file changes (root)")
    ap.add_argument("--gui", action="store_true", help="use dialogs (the app menu entry)")
    ap.add_argument("--notify", action="store_true", help=argparse.SUPPRESS)
    a = ap.parse_args()
    try:
        if a.channel:
            set_channel(a.channel)
            if not (a.apply or a.check or a.status):
                return 0
        cfg = settings()
        if a.rollback:
            return rollback()
        if a.apply:
            return apply(cfg, a.ref, a.yes)
        if a.notify:
            return notify(cfg)
        if a.status:
            v = installed()
            print(f"Installed: {v['COMMIT']} ({v.get('SOURCE', '?')}, {v.get('DATE', 'date unknown')})")
            print(f"Channel:   {cfg['CHANNEL']}" + (f" ({cfg['BRANCH']})" if cfg["CHANNEL"] == "main" else ""))
            print(f"Source:    https://github.com/{cfg['REPO']}")
            print(f"Rollback:  {'available' if os.path.exists(ROLLBACK_DIR + '/manifest.json') else 'none'}")
            return 0
        if a.gui or (not sys.stdout.isatty() and have_display()):
            return gui(cfg)
        if os.geteuid() == 0 and not a.check:
            return apply(cfg, None, a.yes)      # checks, shows what's new, asks, installs
        st = status(cfg)
        print(describe(st))
        if st["state"] == "available":
            if a.check:
                return 10
            print("\nInstall it with:  sudo goggles-update --apply")
        return 0
    except UpdateError as e:
        print(f"goggles-update: {e}", file=sys.stderr)
        if a.gui and have_display():
            kdialog("--error", str(e))
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
