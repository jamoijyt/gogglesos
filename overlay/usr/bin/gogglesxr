#!/usr/bin/python3
"""GogglesXR setup: makes VR games reach the headset without per-game settings.

GogglesXR's first version uses WiVRn (the Monado-based streaming runtime) as its engine and
does the setup that otherwise has to be done by hand:

  1. SteamVR games: puts the OpenVR-to-OpenXR translator (xrizer) first in the OpenVR paths
     file, and puts it back if SteamVR moves itself to the top.
  2. Steam's game containers: sets the two variables that let games see the runtime for the
     whole desktop session, so no launch options are needed.
  3. Checks every link in the chain and says what is wrong in plain words.

  gogglesxr on        set everything up (run once; safe to repeat)
  gogglesxr off       hand VR back to SteamVR (for a wired headset such as the Vive)
  gogglesxr status    check the whole chain; exit 0 if games will reach the headset
  gogglesxr fix       repair the OpenVR paths file if GogglesXR is on (used by the watcher)
  gogglesxr start     open the runtime's window to connect a headset
  gogglesxr dashboard open the GogglesXR dashboard (in the headset if one is connected,
                      otherwise in a preview window). --overlay draws it on top of the
                      running game; the menu button shows and hides it
  gogglesxr library   list the installed games and whether they can run in VR (--json)
  gogglesxr screenshot  save a picture of what the headset shows to Pictures/GogglesXR
  gogglesxr record    start recording what the headset shows, or stop and save (Videos/GogglesXR)
  gogglesxr recenter  make where you stand and the way you face the game's new centre
  gogglesxr quit-game close the VR game that is running
  gogglesxr app       open the GogglesXR desktop app (--background: tray icon only)
  gogglesxr           open the desktop app (menu entry)
"""
import glob
import hashlib
import json
import os
import shutil
import signal
import subprocess
import sys
import time
import urllib.request
import zipfile

ENGINE_APP = "io.github.wivrn.wivrn"
HOME = os.path.expanduser("~")
CONFIG = os.environ.get("XDG_CONFIG_HOME") or os.path.join(HOME, ".config")
RUNTIME_DIR = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
STATE_FILE = os.path.join(CONFIG, "gogglesxr", "state")
VRPATHS = os.path.join(CONFIG, "openvr", "openvrpaths.vrpath")
ENV_FILE = os.path.join(CONFIG, "environment.d", "60-gogglesxr.conf")
ACTIVE_RUNTIME = os.path.join(CONFIG, "openxr", "1", "active_runtime.json")
IPC_SOCKET = os.path.join(RUNTIME_DIR, "wivrn", "comp_ipc")
FLATPAK_ROOTS = ["/var/lib/flatpak", os.path.join(HOME, ".local/share/flatpak")]
WATCHER = "gogglesxr-guard.path"
TITLE = "GogglesXR"
# The dashboard is a Godot 4 project. Ubuntu only packages Godot 3, so the official Godot 4
# build is fetched once (checksum pinned here) unless a Godot 4 is already installed.
DASHBOARD_SRC = "/usr/share/gogglesos/gogglesxr-dashboard"
APP_DIR = os.environ.get("GOGGLESXR_APP_DIR") or "/usr/share/gogglesos/gogglesxr"
DATA = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local/share"), "gogglesxr")
GODOT_VERSION = "4.4.1-stable"
GODOT_BIN = f"Godot_v{GODOT_VERSION}_linux.x86_64"
GODOT_URL = f"https://github.com/godotengine/godot/releases/download/{GODOT_VERSION}/{GODOT_BIN}.zip"
GODOT_SHA256 = "d6e382fb531019f85630c1f485a561a0d20c4a2344b6c3847735cfee7da812aa"
ENV_VARS = ("PRESSURE_VESSEL_IMPORT_OPENXR_1_RUNTIMES", "PRESSURE_VESSEL_FILESYSTEMS_RW")


# ------------------------------------------------------------------ engine
def engine_dir():
    """Folder of the installed runtime (stable across its updates), or None."""
    for root in FLATPAK_ROOTS:
        d = os.path.join(root, "app", ENGINE_APP)
        if os.path.isdir(os.path.join(d, "current", "active", "files")):
            return d
    return None


def translator_dir():
    d = engine_dir()
    if d:
        x = os.path.join(d, "current", "active", "files", "xrizer")
        if os.path.isdir(x):
            return x
    return None


def is_translator(path):
    return "xrizer" in path.lower() or "opencomposite" in path.lower()


# ------------------------------------------------------------------ state
def is_on():
    try:
        with open(STATE_FILE, encoding="utf-8") as f:
            return f.read().strip() == "on"
    except OSError:
        return False


def set_state(on):
    os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
    with open(STATE_FILE, "w", encoding="utf-8") as f:
        f.write("on\n" if on else "off\n")


# ------------------------------------------------------------------ OpenVR paths
def read_vrpaths():
    try:
        with open(VRPATHS, encoding="utf-8") as f:
            data = json.load(f)
        if not isinstance(data, dict):
            raise ValueError
    except (OSError, ValueError):
        data = {"jsonid": "vrpathreg", "version": 1, "config": [], "log": [], "external_drivers": None}
    if not isinstance(data.get("runtime"), list):
        data["runtime"] = []
    return data


def write_vrpaths(data):
    os.makedirs(os.path.dirname(VRPATHS), exist_ok=True)
    if os.path.exists(VRPATHS) and not os.path.exists(VRPATHS + ".gogglesxr-backup"):
        shutil.copy2(VRPATHS, VRPATHS + ".gogglesxr-backup")
    tmp = VRPATHS + ".tmp"
    with open(tmp, "w", encoding="utf-8") as f:
        json.dump(data, f, indent="\t")
        f.write("\n")
    os.replace(tmp, VRPATHS)


def order_vrpaths(translator_first):
    """Put the translator first (GogglesXR on) or last (SteamVR in charge). True if changed."""
    data = read_vrpaths()
    before = list(data["runtime"])
    others = [r for r in before if not is_translator(r)]
    tr = translator_dir()
    if translator_first:
        if not tr:
            return False
        data["runtime"] = [tr] + others
    else:
        # keep a translator entry at the end so switching back on stays quick
        data["runtime"] = others + ([tr] if tr else [])
    if data["runtime"] == before:
        return False
    write_vrpaths(data)
    return True


# ------------------------------------------------------------------ session environment
def wanted_env():
    d = engine_dir()
    return {"PRESSURE_VESSEL_IMPORT_OPENXR_1_RUNTIMES": "1", "PRESSURE_VESSEL_FILESYSTEMS_RW": d} if d else {}


def systemctl(*args):
    try:
        return subprocess.run(["systemctl", "--user", *args], capture_output=True, text=True, timeout=20).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def apply_env(on):
    env = wanted_env() if on else {}
    if env:
        os.makedirs(os.path.dirname(ENV_FILE), exist_ok=True)
        with open(ENV_FILE, "w", encoding="utf-8") as f:
            f.write("# Written by gogglesxr: lets Steam's game containers see the VR runtime\n")
            for k, v in env.items():
                f.write(f"{k}={v}\n")
        systemctl("set-environment", *[f"{k}={v}" for k, v in env.items()])     # apps started from now on
    else:
        try:
            os.remove(ENV_FILE)
        except OSError:
            pass
        systemctl("unset-environment", *ENV_VARS)


def process_env(name):
    """Environment of the first running process called `name`, or None if it isn't running."""
    for path in glob.glob("/proc/[0-9]*/comm"):
        try:
            with open(path, encoding="utf-8") as f:
                if f.read().strip() != name:
                    continue
            with open(os.path.join(os.path.dirname(path), "environ"), "rb") as f:
                raw = f.read().split(b"\0")
            return dict(e.decode(errors="replace").split("=", 1) for e in raw if b"=" in e)
        except (OSError, ValueError):
            continue
    return None


def running(*names):
    return any(process_env(n) is not None for n in names)


# ------------------------------------------------------------------ checks
def checks():
    """List of (ok, title, what to do). ok is True, False, or None for 'not yet'."""
    out = []
    eng = engine_dir()
    out.append((bool(eng), "VR runtime installed",
                "" if eng else "Install it: flatpak install flathub " + ENGINE_APP + "  (or run: gogglesxr on)"))
    on = is_on()
    out.append((on, "GogglesXR is switched on", "" if on else "Run: gogglesxr on"))

    data = read_vrpaths()
    first = data["runtime"][0] if data["runtime"] else ""
    ok = bool(first) and is_translator(first) and os.path.isdir(first)
    out.append((ok, "SteamVR games go to GogglesXR",
                "" if ok else ("SteamVR is first in the list of VR systems. Run: gogglesxr on" if first
                               else "No VR system is registered for SteamVR games. Run: gogglesxr on")))

    steam = process_env("steam")
    want = wanted_env()
    if steam is None:
        saved = os.path.exists(ENV_FILE)
        out.append((saved if want else False, "Steam will let games see the runtime",
                    "" if saved else "Run: gogglesxr on"))
    else:
        ok = bool(want) and all(steam.get(k) == v for k, v in want.items())
        out.append((ok, "Steam lets games see the runtime",
                    "" if ok else "Steam was started before GogglesXR was set up. Quit Steam completely (Steam > Exit) and open it again."))

    if running("vrserver", "vrcompositor", "vrmonitor"):
        out.append((False, "SteamVR is not in the way", "SteamVR is running and will take the games. Close SteamVR."))
    else:
        out.append((True, "SteamVR is not in the way", ""))

    server = os.path.exists(IPC_SOCKET)
    out.append((True if server else None, "Runtime running",
                "" if server else "Open GogglesXR (run: gogglesxr start) and connect the headset."))
    if server:
        target = os.path.realpath(ACTIVE_RUNTIME)
        ok = False
        try:
            with open(target, encoding="utf-8") as f:
                lib = json.load(f)["runtime"]["library_path"]
            ok = os.path.exists(os.path.join(os.path.dirname(target), lib))
        except (OSError, ValueError, KeyError):
            pass
        out.append((ok, "OpenXR games can find the runtime",
                    "" if ok else "The OpenXR registration is missing or broken. Reconnect the headset in the runtime's window."))
    return out


def status_text():
    lines, good = [], True
    for ok, title, todo in checks():
        mark = {True: "✓", False: "✗", None: "…"}[ok]
        lines.append(f" {mark} {title}" + (f"\n     {todo}" if todo else ""))
        if ok is False:
            good = False
    lines.append("")
    lines.append("Ready: start a VR game from Steam. No launch options are needed." if good
                 else "Not ready yet: see the ✗ lines above.")
    lines.append("Games that only support the Oculus runtime can't run in VR on Linux.")
    return "\n".join(lines), good


# ------------------------------------------------------------------ commands
def turn_on():
    if not engine_dir():
        print("Installing the VR runtime (" + ENGINE_APP + ") from Flathub…")
        try:
            subprocess.run(["flatpak", "install", "-y", "--noninteractive", "flathub", ENGINE_APP], check=False)
        except OSError:
            pass
        if not engine_dir():
            print("gogglesxr: the VR runtime isn't installed and couldn't be installed automatically.\n"
                  "Install it with:  flatpak install flathub " + ENGINE_APP, file=sys.stderr)
            return 1
    set_state(True)
    order_vrpaths(True)
    apply_env(True)
    ensure_layer(quiet=False)
    systemctl("enable", "--now", WATCHER)
    text, _ = status_text()
    print(text)
    if process_env("steam") is not None:
        print("\nSteam is running: quit it completely and open it again so games pick up the change.")
    return 0


def turn_off():
    set_state(False)
    systemctl("disable", "--now", WATCHER)
    order_vrpaths(False)
    apply_env(False)
    remove_layer()
    print("GogglesXR is off. SteamVR is in charge of VR games again.\n"
          "If Steam is running, quit it completely and open it again.")
    return 0


def fix():
    if is_on() and order_vrpaths(True):
        print("gogglesxr: put the SteamVR-game translator back in first place")
    return 0


def start():
    try:
        subprocess.Popen(["flatpak", "run", ENGINE_APP], start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError as e:
        print(f"gogglesxr: couldn't start the runtime ({e})", file=sys.stderr)
        return 1
    return 0


def find_godot():
    """A Godot 4 to run the dashboard with: an installed one, or the copy fetched earlier."""
    for name in ("godot4", "godot"):
        path = shutil.which(name)
        if not path:
            continue
        try:
            out = subprocess.run([path, "--version"], capture_output=True, text=True, timeout=20).stdout
        except (OSError, subprocess.SubprocessError):
            continue
        if out.strip().startswith("4."):
            return path
    local = os.path.join(DATA, GODOT_BIN)
    return local if os.access(local, os.X_OK) else None


def fetch_godot():
    os.makedirs(DATA, exist_ok=True)
    archive = os.path.join(DATA, "godot.zip")
    print(f"Fetching Godot {GODOT_VERSION} (about 60 MB, once)…")
    try:
        with urllib.request.urlopen(GODOT_URL, timeout=120) as r, open(archive, "wb") as f:
            shutil.copyfileobj(r, f)
    except OSError as e:
        print(f"gogglesxr: couldn't download Godot ({e}). Check your internet connection.", file=sys.stderr)
        return None
    digest = hashlib.sha256()
    with open(archive, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            digest.update(chunk)
    if digest.hexdigest() != GODOT_SHA256:
        os.remove(archive)
        print("gogglesxr: the Godot download doesn't match the expected file; not using it.", file=sys.stderr)
        return None
    with zipfile.ZipFile(archive) as z:
        z.extract(GODOT_BIN, DATA)
    os.remove(archive)
    path = os.path.join(DATA, GODOT_BIN)
    os.chmod(path, 0o755)
    return path


def load_library():
    sys.path.insert(0, APP_DIR)
    import library
    return library


def dashboard(extra=()):
    extra = list(extra)
    overlay = "--overlay" in extra
    if overlay:
        extra.remove("--overlay")
    src = os.environ.get("GOGGLESXR_DASHBOARD_SRC") or DASHBOARD_SRC
    if not os.path.isfile(os.path.join(src, "project.godot")):
        print(f"gogglesxr: the dashboard isn't installed ({src}). Run: sudo goggles-update", file=sys.stderr)
        return 1
    # Godot keeps a cache next to the project, so run from a copy the user owns
    project = os.path.join(DATA, "dashboard")
    os.makedirs(project, exist_ok=True)
    for name in os.listdir(src):
        if name.endswith((".gd", ".tscn", ".godot", ".tres", ".uid", ".gdextension")) and os.path.isfile(os.path.join(src, name)):
            shutil.copy2(os.path.join(src, name), os.path.join(project, name))
    # The overlay extension: Godot only loads extensions listed in its project cache
    if os.path.isdir(os.path.join(src, "bin")):
        shutil.copytree(os.path.join(src, "bin"), os.path.join(project, "bin"), dirs_exist_ok=True)
        os.makedirs(os.path.join(project, ".godot"), exist_ok=True)
        with open(os.path.join(project, ".godot", "extension_list.cfg"), "w", encoding="utf-8") as f:
            f.write("res://gogglesxr_overlay.gdextension\n")
    try:                                   # games, cover art and the user's choices for the Library panel
        load_library().write_dashboard_list(_show_all_games())
    except Exception as e:                 # the dashboard falls back to reading Steam's files itself
        print(f"gogglesxr: couldn't prepare the game list ({e})", file=sys.stderr)
    godot = find_godot() or fetch_godot()
    if not godot:
        return 1
    if is_on():
        ensure_layer()
    env = dict(os.environ)
    # The real controller models (downloaded by the system install), drawn while the dashboard is open
    env.setdefault("GOGGLESXR_CONTROLLERS", os.path.join(os.path.dirname(DASHBOARD_SRC), "gogglesxr-controllers"))
    if overlay:
        if not os.path.exists(IPC_SOCKET):
            print("gogglesxr: no headset is connected, so there is no game to draw on top of.", file=sys.stderr)
            return 1
        env["GOGGLESXR_OVERLAY"] = "1"
    elif not os.path.exists(IPC_SOCKET):
        print("No headset connected, so the dashboard opens in a preview window.\n"
              "For the headset: gogglesxr start, connect the Quest, then run this again.")
    return subprocess.run([godot, "--path", project, *extra], env=env).returncode


def _show_all_games():
    try:
        with open(os.path.join(CONFIG, "gogglesxr", "settings.json"), encoding="utf-8") as f:
            return bool(json.load(f).get("show_all_games"))
    except (OSError, ValueError):
        return False


def library_command(args):
    lib = load_library()
    games = lib.games()
    if "--json" in args:
        json.dump(games, sys.stdout, indent=1)
        print()
        return 0
    for g in games:
        flags = ("★ " if g["favourite"] else "  ") + ("(hidden) " if g["hidden"] else "")
        print(f"{flags}{g['title']:<40.40} {g['vr_label']}")
    print(f"\n{sum(1 for g in games if g['is_vr'])} of {len(games)} games can run in VR. Manage them in the GogglesXR app.")
    return 0


def app(args):
    try:
        import PyQt6  # noqa: F401
    except ImportError:
        print("gogglesxr: the desktop app needs python3-pyqt6 (sudo apt install python3-pyqt6). Using the simple dialog.",
              file=sys.stderr)
        return gui()
    sys.path.insert(0, APP_DIR)
    import app as desktop_app
    return desktop_app.main(args)


# ------------------------------------------------------------------ in-game actions
# Used by the dashboard's Current Game panel. Each prints one line saying what happened.
#
# Screenshots and recordings come from the GogglesXR capture layer, a small OpenXR API layer
# that VR games load (see gogglesxr/capture-layer/capture.c). It copies the game's own left-eye
# image as the game hands it to the runtime, so captures show what the headset shows, not the
# desktop. It is installed into the home folder because Steam runs games in containers that
# can see the home folder but not /usr.
CACHE = os.path.join(HOME, ".cache")
CAPTURE_DIR = os.path.join(CACHE, "gogglesxr", "capture")   # the layer uses $HOME/.cache too
LAYER_NAME = "libgogglesxr_capture.so"
LAYER_SRC = os.path.join(APP_DIR, "layer", LAYER_NAME)
LAYER_DIR = os.path.join(DATA, "layer")
LAYER_MANIFEST = os.path.join(os.environ.get("XDG_DATA_HOME") or os.path.join(HOME, ".local/share"),
                              "openxr", "1", "api_layers", "implicit.d", "gogglesxr_capture.json")
RECORD_STATE = os.path.join(RUNTIME_DIR, "gogglesxr-recording")
RECORD_SIZE = (1920, 1080)
RECORD_FPS = 30


def ensure_layer(quiet=True):
    """Install (or refresh) the capture layer for this user. Games started afterwards load it."""
    if not os.path.isfile(LAYER_SRC):
        if not quiet:
            print(f"gogglesxr: the capture layer isn't installed ({LAYER_SRC}). Run: sudo goggles-update",
                  file=sys.stderr)
        return False
    lib = os.path.join(LAYER_DIR, LAYER_NAME)
    try:
        os.makedirs(LAYER_DIR, exist_ok=True)
        with open(LAYER_SRC, "rb") as f:
            wanted = f.read()
        try:
            with open(lib, "rb") as f:
                same = f.read() == wanted
        except OSError:
            same = False
        if not same:                       # replace, never rewrite in place: running games have it mapped
            with open(lib + ".new", "wb") as f:
                f.write(wanted)
            os.chmod(lib + ".new", 0o755)
            os.replace(lib + ".new", lib)
        manifest = {"file_format_version": "1.0.0",
                    "api_layer": {"name": "XR_APILAYER_GOGGLES_capture", "library_path": lib,
                                  "api_version": "1.0", "implementation_version": "1",
                                  "description": "GogglesXR: screenshots and recordings of the headset view",
                                  "disable_environment": "DISABLE_GOGGLESXR_CAPTURE"}}
        text = json.dumps(manifest, indent=1) + "\n"
        try:
            with open(LAYER_MANIFEST, encoding="utf-8") as f:
                if f.read() == text:
                    return True
        except OSError:
            pass
        os.makedirs(os.path.dirname(LAYER_MANIFEST), exist_ok=True)
        with open(LAYER_MANIFEST + ".new", "w", encoding="utf-8") as f:
            f.write(text)
        os.replace(LAYER_MANIFEST + ".new", LAYER_MANIFEST)
        return True
    except OSError as e:
        if not quiet:
            print(f"gogglesxr: couldn't install the capture layer ({e})", file=sys.stderr)
        return False


def remove_layer():
    for path in (LAYER_MANIFEST, os.path.join(LAYER_DIR, LAYER_NAME)):
        try:
            os.remove(path)
        except OSError:
            pass


def _user_dir(kind, fallback):
    """The user's Pictures or Videos folder, with a GogglesXR folder inside it."""
    base = ""
    try:
        base = subprocess.run(["xdg-user-dir", kind], capture_output=True, text=True, timeout=5).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        pass
    if not base or base == HOME:
        base = os.path.join(HOME, fallback)
    path = os.path.join(base, "GogglesXR")
    os.makedirs(path, exist_ok=True)
    return path


def _capture_name(game):
    safe = "".join(c for c in (game or "VR") if c.isalnum() or c in " -_").strip() or "VR"
    return f"{safe} {time.strftime('%Y-%m-%d %H.%M.%S')}"


def running_game():
    """(pid of Steam's launcher for the running game, app id), or (None, None)."""
    for path in glob.glob("/proc/[0-9]*/cmdline"):
        try:
            with open(path, "rb") as f:
                args = f.read().split(b"\0")
        except OSError:
            continue
        if b"SteamLaunch" in args:
            for arg in args:
                if arg.startswith(b"AppId="):
                    return int(path.split("/")[2]), arg[6:].decode(errors="replace")
    return None, None


def _game_title(app_id):
    try:
        for game in load_library().games():
            if game["id"] == app_id:
                return game["title"]
    except Exception:
        pass
    return None


def capturable_game():
    """The name of the VR game the capture layer is running in, or None. The layer refreshes
    game.status every 2 seconds while the game draws frames."""
    path = os.path.join(CAPTURE_DIR, "game.status")
    try:
        if time.time() - os.path.getmtime(path) > 6:
            return None
        with open(path, encoding="utf-8", errors="replace") as f:
            name = f.readline().strip()
    except OSError:
        return None
    _, app_id = running_game()
    return _game_title(app_id) or name or "VR game"


def _why_no_capture():
    ensure_layer()
    if running_game()[0] is None:
        return "No VR game is running"
    return ("This game can't be captured yet: restart it once so it picks up GogglesXR's capture "
            "(OpenGL games can't be captured)")


def _png(path, width, height, rgba):
    """Write an RGB PNG (the alpha channel is dropped: games often leave it empty)."""
    import struct
    import zlib
    rgb = bytearray(width * height * 3)
    for channel in range(3):
        rgb[channel::3] = rgba[channel::4]
    stride = width * 3
    raw = b"".join(b"\0" + bytes(rgb[y * stride:(y + 1) * stride]) for y in range(height))

    def chunk(kind, data):
        return struct.pack(">I", len(data)) + kind + data + struct.pack(">I", zlib.crc32(kind + data) & 0xFFFFFFFF)
    with open(path, "wb") as f:
        f.write(b"\x89PNG\r\n\x1a\n")
        f.write(chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0)))
        f.write(chunk(b"IDAT", zlib.compress(raw, 6)))
        f.write(chunk(b"IEND", b""))


def _read_pam(path):
    with open(path, "rb") as f:
        data = f.read()
    end = data.index(b"ENDHDR\n") + 7
    fields = dict(line.split(" ", 1) for line in data[:end].decode().splitlines()[1:-1])
    width, height = int(fields["WIDTH"]), int(fields["HEIGHT"])
    return width, height, memoryview(data)[end:end + width * height * 4]


def screenshot():
    """A picture of what the headset shows (the left eye, full size)."""
    game = capturable_game()
    if not game:
        print(_why_no_capture())
        return 1
    os.makedirs(CAPTURE_DIR, exist_ok=True)
    shot = os.path.join(CAPTURE_DIR, "shot.pam")
    try:
        os.remove(shot)
    except OSError:
        pass
    open(os.path.join(CAPTURE_DIR, "screenshot.request"), "w").close()
    deadline = time.time() + 4
    while not os.path.isfile(shot) and time.time() < deadline:
        time.sleep(0.05)
    if not os.path.isfile(shot):
        try:
            os.remove(os.path.join(CAPTURE_DIR, "screenshot.request"))
        except OSError:
            pass
        print("Couldn't take a screenshot: the game didn't answer")
        return 1
    out = os.path.join(_user_dir("PICTURES", "Pictures"), _capture_name(game) + ".png")
    try:
        _png(out, *_read_pam(shot))
    except (OSError, ValueError, KeyError) as e:
        print(f"Couldn't save the screenshot ({e})")
        return 1
    finally:
        try:
            os.remove(shot)
        except OSError:
            pass
    print("Screenshot saved to " + os.path.relpath(out, HOME))
    return 0


def recording():
    """(ffmpeg's pid, the video's path) for the recording in progress, or (None, None)."""
    try:
        with open(RECORD_STATE, encoding="utf-8") as f:
            pid, path = f.read().split("\n", 1)
        with open(f"/proc/{int(pid)}/cmdline", "rb") as f:
            if b"ffmpeg" not in f.read():
                raise OSError
        return int(pid), path.strip()
    except (OSError, ValueError):
        try:
            os.remove(RECORD_STATE)
        except OSError:
            pass
        return None, None


def _audio_ok():
    """Whether the desktop's sound can be recorded too (PipeWire's PulseAudio service)."""
    try:
        return subprocess.run(["pactl", "info"], capture_output=True, timeout=5).returncode == 0
    except (OSError, subprocess.SubprocessError):
        return False


def _stop_recording(pid, path):
    try:
        os.remove(os.path.join(CAPTURE_DIR, "record.on"))   # the layer sends its last frames and closes
    except OSError:
        pass
    time.sleep(0.6)
    fifo = os.path.join(CAPTURE_DIR, "record.fifo")
    try:                                   # ffmpeg still waiting for a game that never sent a frame
        os.close(os.open(fifo, os.O_WRONLY | os.O_NONBLOCK))
    except OSError:
        pass
    for sig, patience in ((signal.SIGINT, 10.0), (signal.SIGKILL, 2.0)):   # SIGINT: ffmpeg finishes the file
        try:
            os.kill(pid, sig)
        except OSError:
            break
        deadline = time.time() + patience
        while time.time() < deadline and os.path.exists(f"/proc/{pid}"):
            try:                           # reap it if this process started it
                if os.waitpid(pid, os.WNOHANG)[0] == pid:
                    break
            except ChildProcessError:
                pass
            time.sleep(0.1)
        if not os.path.exists(f"/proc/{pid}"):
            break
    for name in (RECORD_STATE, fifo):
        try:
            os.remove(name)
        except OSError:
            pass
    if os.path.isfile(path) and os.path.getsize(path) > 1024:
        print("Recording saved to " + os.path.relpath(path, HOME))
        return 0
    try:
        os.remove(path)
    except OSError:
        pass
    print("The recording stopped, but no video was saved")
    return 1


def record():
    """Start recording what the headset shows (16:9, with the desktop's sound), or stop and save."""
    pid, path = recording()
    if pid:
        return _stop_recording(pid, path)
    game = capturable_game()
    if not game:
        print(_why_no_capture())
        return 1
    if not shutil.which("ffmpeg"):
        print("Recording needs ffmpeg (sudo apt install ffmpeg)")
        return 1
    os.makedirs(CAPTURE_DIR, exist_ok=True)
    fifo = os.path.join(CAPTURE_DIR, "record.fifo")
    try:
        os.remove(fifo)
    except OSError:
        pass
    os.mkfifo(fifo, 0o600)
    width, height = RECORD_SIZE
    path = os.path.join(_user_dir("VIDEOS", "Videos"), _capture_name(game) + ".mp4")
    command = ["ffmpeg", "-nostdin", "-loglevel", "error", "-y",
               "-thread_queue_size", "64", "-f", "rawvideo", "-pix_fmt", "rgba", "-s", f"{width}x{height}",
               "-framerate", str(RECORD_FPS), "-use_wallclock_as_timestamps", "1", "-i", fifo]
    if _audio_ok():
        command += ["-thread_queue_size", "1024", "-f", "pulse", "-i", "@DEFAULT_MONITOR@",
                    "-c:a", "aac", "-b:a", "160k"]
    command += ["-c:v", "libx264", "-preset", "veryfast", "-crf", "20", "-pix_fmt", "yuv420p",
                "-fps_mode", "vfr", "-movflags", "+faststart", path]
    log = os.path.join(CAPTURE_DIR, "ffmpeg.log")
    try:
        with open(log, "w") as err:
            process = subprocess.Popen(command, start_new_session=True, stdin=subprocess.DEVNULL,
                                       stdout=subprocess.DEVNULL, stderr=err)
    except OSError as e:
        print(f"Couldn't start recording ({e})")
        return 1
    with open(RECORD_STATE, "w", encoding="utf-8") as f:
        f.write(f"{process.pid}\n{path}\n")
    with open(os.path.join(CAPTURE_DIR, "record.on"), "w") as f:     # the layer starts sending frames
        f.write(f"{width} {height} {RECORD_FPS}\n")
    time.sleep(1.5)
    if process.poll() is not None:
        try:
            os.remove(os.path.join(CAPTURE_DIR, "record.on"))
            os.remove(RECORD_STATE)
        except OSError:
            pass
        print("Couldn't start recording (see ~/.cache/gogglesxr/capture/ffmpeg.log)")
        return 1
    print("Recording started: " + game)
    return 0


def _descendants(root):
    children = {}
    for path in glob.glob("/proc/[0-9]*/stat"):
        try:
            with open(path, encoding="utf-8", errors="replace") as f:
                fields = f.read().rsplit(")", 1)[1].split()
            children.setdefault(int(fields[1]), []).append(int(path.split("/")[2]))
        except (OSError, IndexError, ValueError):
            continue
    found, todo = [], [root]
    while todo:
        for child in children.get(todo.pop(), []):
            found.append(child)
            todo.append(child)
    return found


def quit_game():
    """Close the running game: ask every process Steam started for it to stop, then insist."""
    pid, app_id = running_game()
    if pid is None:
        print("No game is running")
        return 1
    title = _game_title(app_id) or "the game"
    targets = _descendants(pid)
    for sig, patience in ((signal.SIGTERM, 4.0), (signal.SIGKILL, 2.0)):
        for target in targets:
            try:
                os.kill(target, sig)
            except OSError:
                pass
        deadline = time.time() + patience
        while time.time() < deadline and os.path.exists(f"/proc/{pid}"):
            time.sleep(0.2)
        if not os.path.exists(f"/proc/{pid}"):
            break
        targets = _descendants(pid) or [pid]
    print(f"Closed {title}" if not os.path.exists(f"/proc/{pid}") else f"Couldn't close {title}")
    return 0 if not os.path.exists(f"/proc/{pid}") else 1


# Runs with the VR runtime's own control library (libmonado). Kept as source text so it can also
# run inside the runtime's Flatpak when the library can't be loaded on the desktop side.
RECENTER_CODE = r"""
import ctypes, sys

class Pose(ctypes.Structure):
    _fields_ = [(n, ctypes.c_float) for n in ("qx", "qy", "qz", "qw", "x", "y", "z")]

LOCAL, STAGE = 1, 3
lib = ctypes.CDLL(sys.argv[1])
root = ctypes.c_void_p()
lib.mnd_root_create.argtypes = [ctypes.POINTER(ctypes.c_void_p)]
lib.mnd_root_destroy.argtypes = [ctypes.POINTER(ctypes.c_void_p)]
lib.mnd_root_recenter_local_spaces.argtypes = [ctypes.c_void_p]
if lib.mnd_root_create(ctypes.byref(root)) != 0:
    print("NOT-CONNECTED")
    sys.exit(3)
try:
    # 1. Seated games (the LOCAL space): the runtime puts its centre where the head is now,
    #    facing the way the head faces (turning only around the vertical axis)
    if lib.mnd_root_recenter_local_spaces(root) != 0:
        print("FAILED")
        sys.exit(4)
    # 2. Standing and room-scale games (the STAGE space, which most SteamVR games use): move the
    #    play area's centre to the same place, keeping the floor height
    if hasattr(lib, "mnd_root_set_reference_space_offset"):
        for name in ("mnd_root_get_reference_space_offset", "mnd_root_set_reference_space_offset"):
            getattr(lib, name).argtypes = [ctypes.c_void_p, ctypes.c_int, ctypes.POINTER(Pose)]
        local, stage = Pose(), Pose()
        if (lib.mnd_root_get_reference_space_offset(root, LOCAL, ctypes.byref(local)) == 0 and
                lib.mnd_root_get_reference_space_offset(root, STAGE, ctypes.byref(stage)) == 0):
            new = Pose(local.qx, local.qy, local.qz, local.qw, local.x, stage.y, local.z)
            if lib.mnd_root_set_reference_space_offset(root, STAGE, ctypes.byref(new)) != 0:
                print("LOCAL-ONLY")
                sys.exit(0)
            print("OK")
            sys.exit(0)
    print("LOCAL-ONLY")
finally:
    lib.mnd_root_destroy(ctypes.byref(root))
"""


def _libmonado():
    """The runtime's control library, from the active runtime's manifest:
    (path on the desktop, path inside the runtime's Flatpak or None)."""
    manifest = os.path.realpath(ACTIVE_RUNTIME)
    try:
        with open(manifest, encoding="utf-8") as f:
            lib = json.load(f)["runtime"].get("MND_libmonado_path")
    except (OSError, ValueError, KeyError):
        return None, None
    if not lib:
        return None, None
    lib = os.path.normpath(os.path.join(os.path.dirname(manifest), lib))
    inside = None
    if "/files/" in lib:                   # a Flatpak app's files are at /app inside its sandbox
        inside = "/app/" + lib.split("/files/", 1)[1]
    return lib, inside


def recenter():
    """Make where you stand and the way you face the new centre and "forward" of the game.
    The VR runtime moves the game's world (its seated and its standing/room-scale spaces);
    a VR app can't do that for another app by itself."""
    lib, inside = _libmonado()
    if not lib or not os.path.isfile(lib) or not os.path.exists(IPC_SOCKET):
        print("Can't recentre the game: the VR runtime isn't running")
        return 1
    answer = ""
    try:                                   # on the desktop side first: quickest
        answer = subprocess.run([sys.executable, "-I", "-c", RECENTER_CODE, lib], capture_output=True,
                                text=True, timeout=10).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        pass
    if not answer and inside:              # the library needs the runtime's own system libraries
        try:
            answer = subprocess.run(["flatpak", "run", "--command=python3", ENGINE_APP, "-I", "-c",
                                     RECENTER_CODE, inside], capture_output=True, text=True,
                                    timeout=30).stdout.strip()
        except (OSError, subprocess.SubprocessError):
            pass
    answer = answer.splitlines()[-1] if answer else ""
    messages = {"OK": "Game recentred",
                "LOCAL-ONLY": "Recentred (this runtime can only move seated games)",
                "NOT-CONNECTED": "Can't recentre the game: no headset is connected",
                "FAILED": "The VR runtime couldn't recentre right now: hold still and try again"}
    print(messages.get(answer, "Can't recentre the game: the VR runtime's control library didn't load"))
    return 0 if answer in ("OK", "LOCAL-ONLY") else 1


def gui():
    if not shutil.which("kdialog"):
        return status()
    text, _ = status_text()
    choice = subprocess.run(
        ["kdialog", "--title", TITLE, "--menu", text.replace("\n", "<br>").replace(" ", "&nbsp;"),
         "start", "Open the runtime and connect a headset",
         "dashboard", "Open the dashboard",
         "on", "Set up / repair GogglesXR",
         "off", "Switch off (use SteamVR, for wired headsets)"],
        capture_output=True, text=True)
    if choice.returncode != 0:
        return 0
    rc = {"start": start, "on": turn_on, "off": turn_off, "dashboard": dashboard}[choice.stdout.strip()]()
    if choice.stdout.strip() in ("on", "off"):
        text, _ = status_text()
        subprocess.run(["kdialog", "--title", TITLE, "--msgbox", text])
    return rc


def status():
    if "--json" in sys.argv[2:]:
        items = [{"ok": ok, "title": title, "todo": todo} for ok, title, todo in checks()]
        json.dump({"ready": all(i["ok"] is not False for i in items), "checks": items}, sys.stdout, indent=1)
        print()
        return 0 if all(i["ok"] is not False for i in items) else 1
    text, good = status_text()
    print(text)
    return 0 if good else 1


def main():
    cmd = sys.argv[1] if len(sys.argv) > 1 else "app"
    actions = {"on": turn_on, "off": turn_off, "status": status, "fix": fix, "start": start, "--gui": gui,
               "dashboard": lambda: dashboard(sys.argv[2:]), "library": lambda: library_command(sys.argv[2:]),
               "app": lambda: app(sys.argv[2:]), "screenshot": screenshot, "record": record,
               "quit-game": quit_game, "recenter": recenter, "recentre": recenter}
    if cmd not in actions:
        print(__doc__.strip(), file=sys.stderr)
        return 2
    return actions[cmd]()


if __name__ == "__main__":
    sys.exit(main())
